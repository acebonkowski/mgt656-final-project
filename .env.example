# Copy to .env for local use (never commit .env). On Render, set these in the
# dashboard per service. Placeholders only: no real values in this file.

# Local dev: set to true to fall back to SQLite and a dev secret key.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
APP_ENV=local                      # local | staging | production

# Comma-separated. On Render the service hostname is added automatically.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Supabase -> Connect -> "Session pooler" string (IPv4, port 5432).
# Staging and production each use their OWN Supabase project.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# A/B test page: path is "/" + first 7 chars of sha1(TEAM_NICKNAME).
# Holds the nickname, never the hash. Defaults to holy-dew if unset.
TEAM_NICKNAME=holy-dew
# Comma-separated course nicknames shown on the A/B page.
# TEAM_MEMBER_NICKNAMES=nickname-one,nickname-two
# Optional MapTiler server key for address autocomplete. The local map works
# without it.
MAP_API_KEY=

# Private profile-photo storage: use this environment's Supabase project URL and
# legacy service_role key. Server-only; never put this key in JavaScript.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_KEY=
SUPABASE_PHOTO_BUCKET=profile-photos

# OpenRouter LLM key (course credits). Server-side only: never commit it and
# never pass it to browser JavaScript. Tests mock the LLM and never need it.
OPENROUTER_API_KEY=
# Recommended: text, image and audio input, structured output, low cost.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# Login codes (#6), sent through Resend's SMTP relay. Without a key, local
# development prints emails to the terminal; staging/production refuse to send.
RESEND_API_KEY=
EMAIL_FROM="Yale Events <login@mail.your-domain.example>"
# EMAIL_PORT=587                   # Resend also accepts 2587 if a host blocks 587
# Fixed 6-digit code for the seeded grader accounts. Same value on staging and
# production; share it only privately (submission notes), never in git.
GRADER_FIXED_OTP=

# Optional tuning
# DATABASE_CONN_MAX_AGE=60
# DATABASE_SSL_REQUIRE=true
# DATABASE_DISABLE_SERVER_SIDE_CURSORS=false   # true if using the transaction pooler (6543)
# LOG_LEVEL=INFO

# #33 event imports. POST /internal/import-events/ with Authorization: Bearer <token>.
# Set a long random secret separately for each deployed environment.
AGGREGATOR_TOKEN=
AGGREGATOR_RUN_SECONDS=180
AGGREGATOR_WINDOW_DAYS=90
# Paid OpenRouter calls remain disabled until a team-approved budget is configured.
AGGREGATOR_MAX_IMAGES_PER_RUN=0
AGGREGATOR_MAX_CLASSIFICATIONS_PER_RUN=0
# Optional free Ticketmaster Discovery key; without it this source is logged as skipped.
TICKETMASTER_API_KEY=
# Override only with approved HTTPS feed hosts (see core/event_import/sources.py).
AGGREGATOR_YALE_URL=https://yaleconnect.yale.edu/ical/yale/ical_yale.ics
AGGREGATOR_SOM_URL=https://groups.som.yale.edu/ical/yalesom/ical_yalesom.ics
SUPABASE_EVENT_PHOTO_BUCKET=event-photos
