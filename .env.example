# Copy to .env for local use (never commit .env). On Render, set these in the
# dashboard per service. Placeholders only: no real values in this file.

# Local dev: set to true to fall back to SQLite and a dev secret key.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me
APP_ENV=local                      # local | staging | production

# Comma-separated. On Render the service hostname is added automatically.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Supabase -> Connect -> "Session pooler" string (IPv4, port 5432).
# Staging and production each use their OWN Supabase project.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Browser map key (#8). Leave empty to show the map fallback message.
# Restrict the key to our domains in the map provider's console.
MAP_API_KEY=

# Optional tuning
# DATABASE_CONN_MAX_AGE=60
# DATABASE_SSL_REQUIRE=true
# DATABASE_DISABLE_SERVER_SIDE_CURSORS=false   # true if using the transaction pooler (6543)
# LOG_LEVEL=INFO
